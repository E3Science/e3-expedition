# Browser-safe configuration (copy to .env.local for local development)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_GAME_SERVER_URL=http://localhost:2567

# Server-only configuration (place in server/.env; never expose these values)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PORT=2567
# Comma-separated public website origins allowed to call the server API.
CLIENT_ORIGINS=http://localhost:8080,https://YOUR-SITE.onrender.com

# Google Classroom OAuth — create a Web application client in Google Cloud.
GOOGLE_CLASSROOM_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLASSROOM_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CLASSROOM_REDIRECT_URI=https://YOUR_SERVER.example.com/auth/google/classroom/callback
# For local Classroom testing, use this instead and register the exact URI in Google Cloud:
# GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:2567/auth/google/classroom/callback
