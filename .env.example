# Browser-safe configuration (copy to .env.local for local development)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Google Classroom OAuth — store these as Supabase Edge Function secrets.
GOOGLE_CLASSROOM_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLASSROOM_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CLASSROOM_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/classroom?action=callback
E3_FRONTEND_URL=https://e3-expedition.onrender.com
